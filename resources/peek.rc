#include <windows.h>
#include "resource.h"

// Keep the application manifest embedded as resource 1 for Win32 activation contexts.
1 RT_MANIFEST "peek.manifest"

IDI_PEEK ICON "peek.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HaBaDEDE\0"
            VALUE "FileDescription", "Peek - Native Windows observation utility\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "Peek\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 HaBaDEDE\0"
            VALUE "OriginalFilename", "Peek.exe\0"
            VALUE "ProductName", "Peek\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
